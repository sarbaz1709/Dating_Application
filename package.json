    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
