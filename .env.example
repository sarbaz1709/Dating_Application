# Public client configuration only. These values are bundled into the app,
# so NEVER put secret keys (service role / sb_secret_ / OpenAI) here.
#
# Copy this file to `.env.local` and fill in the values.
#
# Local development: run `npm run db:start`, then copy the "API URL" and the
# "Publishable" key it prints. On a physical phone, replace 127.0.0.1 with your
# computer's LAN IP (e.g. http://192.168.1.20:54321).
#
# Hosted project: Supabase Dashboard > Project Settings > API Keys.

EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
